# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# CloudCap runtime state — regenerated by scans; may contain real findings,
# project ids, and operator emails. Keep the static eval fixtures + code.
eval/*.json
eval/*.jsonl
!eval/ground_truth.json
eval/prs/
eval/tickets/

# Terraform — state is sensitive; real tfvars are per-deployment (see *.example)
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
*.tfplan

# Local tooling / logs
.claude/settings.local.json
.claude/scheduled_tasks.lock
*.log

# Secrets — NEVER commit (this repo is public). Real secrets live in Secret Manager.
.env
.env.*
*.pem
*.key
*-key.json
*_key.json
service-account*.json
credentials*.json
gha-creds-*.json
*.tfvars.json
secrets.*
**/*secret*.json
!webui/firebase_web.json   # Firebase WEB config is public-safe (client key), keep it

# OS / editor
.DS_Store
