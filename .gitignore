# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# CloudCap runtime state — regenerated by scans; may contain real findings,
# project ids, and operator emails. Keep the static eval fixtures + code.
eval/*.json
eval/*.jsonl
!eval/ground_truth.json
eval/prs/
eval/tickets/

# Terraform — state is sensitive; real tfvars are per-deployment (see *.example)
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
*.tfplan

# Local tooling / logs
.claude/settings.local.json
.claude/scheduled_tasks.lock
*.log

# OS / editor
.DS_Store
